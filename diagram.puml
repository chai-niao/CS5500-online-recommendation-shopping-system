@startuml
title E-Commerce Platform - Three-Tier Architecture

package "PRESENTATION LAYER (Frontend)" #E3F2FD {
    [Web UI (React)\n----\nUser Interface\nShopping Cart\nChatbot Interface\n\nTools: VS Code, Git\nTech: React, JavaScript, HTML/CSS] as WebUI
}

package "API Interface" #FFE0B2 {
    [RESTful API\nHTTPS / JSON] as API
}

package "BUSINESS LOGIC LAYER (Backend)" #FFF3E0 {
    [User Service] as User
    [Order & Payment\nService (Mock)] as Order
    [Inventory Service] as Inventory
    [Festival Campaign\nService] as Campaign
    [Chatbot Service] as Chatbot
    [Recommendation Engine\n----\nHybrid Algorithm:\nCollaborative +\nContent Filtering] as Reco
    
    note right of User
        Tools: VS Code, Docker, Git
        Tech: FastAPI/Node.js
        RESTful API
        JWT Authentication
    end note
}

cloud "OpenAI API\n(Cloud-hosted LLM)\nPrompt-based Inference" as OpenAI #F3E5F5

package "Data Interface" #C8E6C9 {
    [SQL / NoSQL\nQueries] as DataAPI
}

package "DATA LAYER (Databases)" #E8F5E9 {
    database "PostgreSQL\n----\nUser Profiles\nProduct Catalog\nInventory\nStore Layout\nTransactions (Mock)" as PG
    database "MongoDB\n----\nInteraction Logs\nUser Behavior" as Mongo
}

WebUI --> API
API --> User
API --> Order
API --> Inventory
API --> Campaign
API --> Chatbot
API --> Reco

Chatbot --> OpenAI : API Call

User --> DataAPI
Order --> DataAPI
Inventory --> DataAPI
Campaign --> DataAPI
Chatbot --> DataAPI
Reco --> DataAPI

DataAPI --> PG
DataAPI --> Mongo

legend right
|= Component |= Details |
| **Tools** | Git, Docker, VS Code |
| **Technologies** | React, FastAPI/Node.js, RESTful API, JWT Auth |
| **Databases** | PostgreSQL, MongoDB |
| **AI Models** | Chatbot API (Cloud LLM)\nHybrid Recommendation Algorithm |
endlegend

@enduml