PORT=5000
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hypermarket
DB_USER=postgres
DB_PASSWORD=replace_with_db_password

# MongoDB
MONGO_URI=mongodb://localhost:27017/hypermarket

# OpenAI API
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Recommendation Pipeline (2-4-3-5)
# 2 = Tag system, 4 = Formula ranker, 3 = Embedding hybrid, 5 = AI auto tag extraction
RANK_WEIGHT_TAG=0.5
RANK_WEIGHT_POPULARITY=0.2
RANK_WEIGHT_RATING=0.15
RANK_WEIGHT_FEATURED=0.05
RANK_WEIGHT_PRICE=0.05
RANK_WEIGHT_FRESHNESS=0.05
RANK_BLEND_EMBEDDING=0.25

# 3) Embedding service slot (BAAI)
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=BAAI
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# Optional model path override (cross-platform). Leave empty to use service default.
# EMBEDDING_MODEL_DIR=/absolute/path/to/models/bge-m3

# 5) AI auto tag extraction slot (Qwen2.5-7B-Instruct)
TAG_EXTRACTION_ENABLED=true
TAG_EXTRACTION_MODEL=Qwen2.5-7B-Instruct
TAG_EXTRACTION_SERVICE_URL=http://127.0.0.1:8002
# Optional model path override (cross-platform). Leave empty to use service default.
# QWEN_MODEL_DIR=/absolute/path/to/models/Qwen2.5-7B-Instruct

RANK_ENABLE_AI_TAG_ENRICHMENT=false
RANK_AI_TAG_MAX_CANDIDATES=30
RANK_AI_TAG_CONCURRENCY=6

RANK_ENABLE_COLLABORATIVE=true
COLLAB_CACHE_TTL_SEC=60
